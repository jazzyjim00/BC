      const b = document.createElement('button');
      b.textContent = label;
      b.dataset.base = label;
      b.style.cssText = 'flex:1;min-width:0;font:11px system-ui;background:transparent;color:#aaa;border:0;border-bottom:2px solid transparent;padding:7px 2px;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis';
      b.onclick = () => selectTab(key);
      tabBtns[key] = b;
      return b;
    };
    tabBar.appendChild(mkTab('regular', 'Regular'));
    tabBar.appendChild(mkTab('premium', '★ Premium'));
    tabBar.appendChild(mkTab('faves', FAVE_COUNTRIES.join('·')));
    tabBar.appendChild(mkTab('ghosts', '👻 Ghosts'));
    tabBar.appendChild(mkTab('favorites', '⭐ Faves'));

    statusEl = document.createElement('div');
    statusEl.style.cssText = 'padding:5px 10px;color:#999;border-bottom:1px solid #222';
    listEl = document.createElement('div');
    listEl.style.cssText = 'overflow:auto;padding:4px 0';

    box.append(head, tabBar, statusEl, listEl);
    document.body.appendChild(box);
    dragify(box, head);
    updateTabStyles();
    loadTab(false);
  }

  function updateTabStyles() {
    Object.entries(tabBtns).forEach(([k, b]) => {
      const on = k === activeTab;
      b.style.color = on ? '#6cf' : '#aaa';
      b.style.borderBottomColor = on ? '#6cf' : 'transparent';
      b.style.background = on ? '#181818' : 'transparent';
    });
    const g = ghosts().length;
    if (tabBtns.ghosts) tabBtns.ghosts.textContent = '👻 Ghosts' + (g ? ' ' + g : '');
    if (tabBtns.favorites) tabBtns.favorites.textContent = '⭐ Faves' + (favorites.size ? ' ' + favorites.size : '');
  }

  function selectTab(key) {
    if (key === activeTab) return;
    activeTab = key;
    updateTabStyles();
    if (key === 'ghosts') renderList();
    // Switching to Favourites re-checks enterability for everything in it.
    else if (key === 'favorites') { renderList(); checkFavorites(true); }
    else loadTab(true);   // always re-fetch the list when switching tabs
  }

  function setWatch(on) {
    watching = on;
    clearTimeout(watchTimer);
    watchBtn.style.background = on ? '#164a2a' : '#2b2b2b';
    watchBtn.style.borderColor = on ? '#2a6' : '#444';
    if (!on) return;
    (async function tick() {
      // Scan every list, not just the active one — a room "vanishing" is often
      // a room moving between lists, and we can only see that if we watch all.
      for (const t of TABS) {
        try { await scanTab(t); } catch (e) { console.warn('[ti-ghost] scan failed', t, e.message); }
      }
      if (activeTab !== 'ghosts') rooms = cache[activeTab] || rooms;
      renderList();
      if (watching) watchTimer = setTimeout(tick, POLL_MS);
    })();
  }

  // Header "grid 6" — the first six of whatever tab you're on.
  function pickForGrid() {
    return rooms.slice(0, GRID_N);
  }

  function renderRow(r, ghost) {
    const row = document.createElement('div');
    const pinned = PIN.includes((r.countryCode || '').toUpperCase());
    const wrap = document.createElement('div');
    const reg = ghost ? registry.get(rid(r)) : null;
    const vst = (reg && reg.verdict && reg.verdict.state) || null;
    row.style.cssText = 'display:flex;align-items:center;gap:8px;padding:5px 10px;border-bottom:1px solid #1e1e1e;' +
      (ghost ? (vst === 'moved' ? 'background:#152430;' : vst === 'alive' ? 'background:#16251c;' : vst === 'ended' || vst === 'dead' ? 'background:#1a1a1a;opacity:.62;' : 'background:#211a26;')
             : r.__hidden ? 'background:#2a2113;' : pinned ? 'background:#15201a' : '') +
      // Only dim in "all" mode — in faves mode GB is wanted but isn't in PIN,
      // so keying the dim off `pinned` alone would grey out a row you asked for.
      (ghost && ghostFilter === 'all' && !pinned ? 'opacity:.4;' : '');

    // Favourite toggle. Stores the room's payload, not just its id, so a
    // favourite stays playable after it drops off every list.
    const isFav = favorites.has(rid(r));
    const cb = document.createElement('button');
    cb.textContent = isFav ? '★' : '☆';
    cb.title = isFav ? 'remove from favourites' : 'add to favourites';
    cb.style.cssText = 'flex:0 0 auto;background:none;border:0;cursor:pointer;font-size:16px;line-height:1;padding:0 2px;color:' + (isFav ? '#e6b04a' : '#555');
    cb.onclick = (ev) => { ev.stopPropagation(); toggleFave(r); };

    const thumb = document.createElement('div');
    thumb.style.cssText = `width:34px;height:34px;border-radius:6px;flex:0 0 auto;background:#333 center/cover no-repeat;${r.frontImage ? `background-image:url('${r.frontImage}')` : ''}${ghost ? ';filter:grayscale(1) brightness(.7)' : ''}`;

    const meta = document.createElement('div');
    meta.style.cssText = 'flex:1;min-width:0';
    const e = reg;
    const gone = e ? goneAt(e) : 0;
    // Auto-probe verdict, rendered as a badge line under the room.
    const BADGE = {
      moved:   ['#7fd0ff', '➜ moved'],
      alive:   ['#7f7', '● alive · unlisted'],
      ended:   ['#888', '○ ended'],
      dead:    ['#c88', '✕ gone'],
      unclear: ['#e0b060', '? unclear'],
      probing: ['#8cf', '… probing'],
      queued:  ['#666', '… queued'],
    };
    // In the Favourites tab the badge comes from the enterability check
    // instead of the ghost verdict.
    const FAVE_BADGE = {
      enterable: ['#7f7', '● enterable'],
      open:      ['#5c5', '● playing now'],
      ended:     ['#888', '○ ended'],
      dead:      ['#c88', '✕ not enterable'],
      unclear:   ['#e0b060', '? unclear'],
      checking:  ['#8cf', '… checking'],
    };
    const fs = activeTab === 'favorites' ? faveState.get(rid(r)) : null;
    const bd = fs ? FAVE_BADGE[fs.state] : (vst && BADGE[vst]);
    const why = fs ? fs.why : (e && e.verdict && e.verdict.why);
    meta.innerHTML =
      `<div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${(r.roomName || r.nickname || r.strRoomId || '').replace(/[<>&]/g, '')}${r.isPremium ? ' <span style="color:#e6b04a">★</span>' : ''}</div>` +
      `<div style="color:#888;font-size:11px">${openRooms.has(rid(r)) ? '<span style="color:#5c5">● open</span> · ' : ''}` +
      `${r.__hidden ? '<span style="color:#e0b060">⊘ hidden (inLive=false)</span> · ' : ''}` +
      `${ghost ? `<span style="color:#b98cd8">gone ${ago(gone)}</span> · from ${Object.keys(e.goneFrom).join(',')} · ` : ''}` +
      `<span style="color:${pinned ? '#6f6' : '#9bd'}">${r.countryCode || '??'}</span> · 👤 ${r.onlineCount || 0}</div>` +
      (bd ? `<div style="color:${bd[0]};font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${bd[1]}${why ? ' <span style="color:#777">· ' + String(why).replace(/[<>&]/g, '') + '</span>' : ''}</div>` : '') +
      (!fs && bd && e.verdict.diff && e.verdict.diff.length ? `<div style="color:#c9a6e8;font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="${e.verdict.diff.join(' | ').replace(/["<>&]/g, '')}">Δ ${e.verdict.diff.join(' · ').replace(/[<>&]/g, '')}</div>` : '');

    const play = document.createElement('button');
    play.textContent = '▶ play';
    play.style.cssText = 'font:12px system-ui;background:#22406a;color:#dff;border:1px solid #356;border-radius:6px;padding:3px 9px;cursor:pointer';
    play.onclick = () => openPlayers([r]);

    row.append(cb, thumb, meta, play);
    wrap.appendChild(row);

    // "open" is tracked optimistically — we mark a room open when we start
    // loading it and rely on the player window to report back when it stops.
    // If that window is closed abruptly, or the tile never connected, the flag
    // can get stuck. This clears it for one room.
    if (openRooms.has(rid(r))) {
      const clr = document.createElement('button');
      clr.textContent = '↺';
      clr.title = 'clear the "open" flag — use when a room shows open but is not actually playing';
      clr.style.cssText = 'font:12px system-ui;background:#4a2b2b;color:#fdd;border:1px solid #8a4848;border-radius:6px;padding:3px 8px;cursor:pointer';
      clr.onclick = (ev) => {
        ev.stopPropagation();
        openRooms.delete(rid(r));
        faveState.delete(rid(r));      // drop a stale "playing now" verdict too
        renderList();
        // Re-check just this one: checkFavorites without force only probes
        // favourites that have no state yet.
        if (activeTab === 'favorites') checkFavorites(false);
      };
      row.insertBefore(clr, play);
    }

    if (ghost) {
      // Probe: ask /enter what the room says about itself now, and diff that
      // against the last listing payload. Whatever changed is what hid it.
      const detail = document.createElement('pre');
      detail.style.cssText = 'display:none;margin:0;padding:6px 10px;background:#0e0e0e;color:#9c9;font:11px/1.35 ui-monospace,monospace;white-space:pre-wrap;word-break:break-all;border-bottom:1px solid #1e1e1e;max-height:220px;overflow:auto';
      const probe = document.createElement('button');
      probe.textContent = '🔍';
      probe.title = 'probe: enter the room and diff it against its last listing';
      probe.style.cssText = 'font:12px system-ui;background:#3a2b4a;color:#e8d8ff;border:1px solid #64488a;border-radius:6px;padding:3px 8px;cursor:pointer';
      probe.onclick = async () => {
        probe.disabled = true; probe.textContent = '…';
        detail.style.display = 'block';
        detail.textContent = 'probing ' + rid(r) + '…';
        const res = await probeGhost(e);
        e.probed = true;
        e.verdict = classify(res);
        e.verdict.diff = res.diff;
        detail.textContent = [
          'verdict: ' + e.verdict.state.toUpperCase() + ' — ' + e.verdict.why,
          'enter: ' + (res.err ? 'FAILED — ' + res.err : res.rv ? 'ok, roomVo returned' : 'ok, but no roomVo'),
          res.inOther.length ? 'currently listed in: ' + res.inOther.join(', ') : 'not in any list we scan',
          '',
          res.diff.length ? 'changed vs last listing:\n  ' + res.diff.join('\n  ') : 'no scalar field changed vs last listing',
          '',
          'history:',
          ...e.history.slice(-12).map((h) => '  [' + ago(h.t) + ' ago] ' + h.ev + (h.diff && h.diff.length ? '\n      ' + h.diff.join('\n      ') : '')),
          '',
          '(full enter payload logged to console)',
        ].join('\n');
        probe.disabled = false; probe.textContent = '🔍';
      };
      // Locate: walk every searchable list looking for this room id, so a
      // "disappearance" that is really a move gets named as one.
      const loc = document.createElement('button');
      loc.textContent = '📍';
      loc.title = 'locate: search every known list (plus this room\'s country filter) for it';
      loc.style.cssText = 'font:12px system-ui;background:#23394a;color:#dff;border:1px solid #3a6a8a;border-radius:6px;padding:3px 8px;cursor:pointer';
      loc.onclick = async () => {
        loc.disabled = true;
        detail.style.display = 'block';
        const res = await locateRoom(e, (l) => { detail.textContent = 'searching ' + l + '…'; });
        detail.textContent = res.found.length
          ? ['FOUND — the room moved, it did not stop.', '',
             ...res.found.map((f) => '  ' + f.list + ' (page ' + f.page + ')' + (f.diff.length ? '\n      changed: ' + f.diff.join('\n      changed: ') : '\n      identical payload')),
            ].join('\n')
          : 'not found in any of ' + res.searched.length + ' lists:\n  ' + res.searched.join('\n  ') +
            '\n\nEither it really is off every list, or the list holding it is one we do not know.\nRun 🔎 Lists to hunt for endpoints we are not probing.';
        loc.disabled = false;
        updateTabStyles();
      };
      row.insertBefore(loc, play);
      row.insertBefore(probe, loc);
      wrap.appendChild(detail);
    }
    return wrap;
  }

  // Rows are chunked into groups of GRID_N, each led by a divider with a
  // button that launches exactly those rooms as a grid.
  function renderList() {
    listEl.innerHTML = '';
    const ghostMode = activeTab === 'ghosts';
    const faveMode = activeTab === 'favorites';
    if (ghostMode) {
      const all = ghosts().map((e) => e.last).filter(Boolean);
      ghostTotal = all.length;
      rooms = all.filter(ghostMatch[ghostFilter]);
      ghostHiddenCount = all.length - rooms.length;
    }

    if (faveMode) {
      rooms = favoriteRooms();
      const ctl = document.createElement('div');
      ctl.style.cssText = 'display:flex;align-items:center;gap:8px;padding:6px 10px;border-bottom:1px solid #1e1e1e';
      const re = document.createElement('button');
      re.textContent = faveChecking ? 'checking…' : '⟳ recheck';
      re.disabled = faveChecking;
      re.style.cssText = 'font:12px system-ui;background:#22406a;color:#dff;border:1px solid #356;border-radius:6px;padding:3px 9px;cursor:pointer';
      re.onclick = () => checkFavorites(true);
      const note = document.createElement('span');
      note.style.cssText = 'color:#777;font-size:11px;flex:1';
      const live = rooms.filter((r) => { const s = faveState.get(rid(r)); return s && (s.state === 'enterable' || s.state === 'open'); }).length;
      note.textContent = faveNote || (rooms.length ? `${live} of ${rooms.length} enterable` : '');
      if (faveNote) note.style.color = faveNote[0] === '⚠' ? '#e08080' : '#8cf';
      const mkIo = (label, title, fn) => {
        const b = document.createElement('button');
        b.textContent = label; b.title = title;
        b.style.cssText = 'font:12px system-ui;background:#2b2b2b;color:#dfd;border:1px solid #444;border-radius:6px;padding:3px 8px;cursor:pointer';
        b.onclick = fn;
        return b;
      };
      const ex = mkIo('⇩', 'export favourites to a .json file', () => exportFavorites());
      const im = mkIo('⇧', 'import favourites from a .json file — merges by default, shift-click to replace', (ev) => {
        const replace = ev.shiftKey;
        if (replace && favorites.size && !confirm('Replace all ' + favorites.size + ' favourite(s) with the file contents?')) return;
        pickFaveFile(replace);
      });
      ctl.append(re, ex, im, note);
      listEl.appendChild(ctl);

      if (!rooms.length) {
        const empty = document.createElement('div');
        empty.style.cssText = 'padding:14px 12px;color:#888;font-size:12px;line-height:1.5';
        empty.innerHTML = 'No favourites yet. Click the ☆ beside any room — on any tab, including 👻 Ghosts — to keep it here. ' +
          'Favourites store the room\'s full payload, so they stay playable after the room drops off every list, ' +
          'and this tab re-checks whether each one can still be entered every time you open it. ' +
          'Already have a list from another browser? Hit <b>⇧</b> above to import it.';
        listEl.appendChild(empty);
        updateStatus();
        return;
      }
    }

    if (ghostMode) {
      // Filter toggle. Rendered BEFORE the empty check — filtering everything
      // out must not strand you without a way to switch back.
      const ctl = document.createElement('div');
      ctl.style.cssText = 'display:flex;align-items:center;gap:8px;padding:6px 10px;border-bottom:1px solid #1e1e1e';
      const tg = document.createElement('button');
      tg.textContent = ghostLabel[ghostFilter];
      tg.title = 'click to cycle: pinned → ' + FAVE_COUNTRIES.join('/') + ' → all';
      const tone = { pinned: ['#164a2a', '#2a6', '#dff'], faves: ['#3a2b4a', '#64488a', '#e8d8ff'], all: ['#2b2b2b', '#444', '#aaa'] }[ghostFilter];
      tg.style.cssText = `font:12px system-ui;border-radius:6px;padding:3px 9px;cursor:pointer;background:${tone[0]};border:1px solid ${tone[1]};color:${tone[2]}`;
      tg.onclick = () => {
        ghostFilter = GHOST_FILTERS[(GHOST_FILTERS.indexOf(ghostFilter) + 1) % GHOST_FILTERS.length];
        renderList();
      };
      const note = document.createElement('span');
      note.style.cssText = 'color:#777;font-size:11px;flex:1';
      note.textContent = ghostTotal
        ? rooms.length + ' of ' + ghostTotal + (ghostHiddenCount ? ' · ' + ghostHiddenCount + (ghostFilter === 'all' ? ' dimmed' : ' filtered out') : '')
        : 'no ghosts yet';
      ctl.append(tg, note);
      listEl.appendChild(ctl);

      if (!rooms.length) {
        const empty = document.createElement('div');
        empty.style.cssText = 'padding:14px 12px;color:#888;font-size:12px;line-height:1.5';
        empty.innerHTML = ghostHiddenCount
          ? `all ${ghostHiddenCount} ghost(s) are filtered out by <b>${ghostLabel[ghostFilter]}</b> — click the toggle to widen it.`
          : watching
            ? 'No ghosts yet. Watching every list every ' + Math.round(POLL_MS / 1000) + 's — a room shows up here once it misses ' + MISS_STRIKES + ' consecutive scans of every list it was in'
              + (AUTO_PROBE ? ', and gets probed on arrival so the still-enterable ones sort to the top.' : '. Auto-probe is off; use 🔍 per row.')
            : 'Ghost tracking needs watch mode. Hit 👁 in the header, leave it running, and rooms that drop off the listings collect here with their last payload.';
        listEl.appendChild(empty);
        updateStatus();
        return;
      }

    }

    for (let start = 0; start < rooms.length; start += GRID_N) {
      const group = rooms.slice(start, start + GRID_N);

      const divider = document.createElement('div');
      divider.style.cssText = 'display:flex;align-items:center;gap:8px;padding:6px 10px;background:#12271a;border-top:1px solid #2a2a2a;border-bottom:1px solid #223;';
      const label = document.createElement('span');
      label.style.cssText = 'flex:1;color:#8aa892;font-size:11px;letter-spacing:.3px';
      label.textContent = `rooms ${start + 1}–${start + group.length}`;
      const gbtn = document.createElement('button');
      gbtn.textContent = `▶ grid these ${group.length}`;
      gbtn.style.cssText = 'font:12px system-ui;background:#164a2a;color:#dff;border:1px solid #2a6;border-radius:6px;padding:3px 9px;cursor:pointer';
      gbtn.onclick = () => openPlayers(group);
      divider.append(label, gbtn);
      listEl.appendChild(divider);

      group.forEach((r) => listEl.appendChild(renderRow(r, ghostMode)));
    }
    updateStatus();
  }

  function updateStatus() {
    updateTabStyles();
    if (activeTab === 'favorites') {
      const tally = {};
      favorites.forEach((r, id) => { const s = (faveState.get(id) || {}).state || 'unchecked'; tally[s] = (tally[s] || 0) + 1; });
      const parts = Object.keys(tally).sort().map((k) => tally[k] + ' ' + k).join(' · ');
      statusEl.innerHTML = `favourites · ${favorites.size}` + (parts ? ' · ' + parts : '') +
        (faveChecking ? ' · <span style="color:#8cf">checking…</span>' : '');
      return;
    }
    if (activeTab === 'ghosts') {
      const tally = {};
      ghosts().forEach((e) => { const s = (e.verdict && e.verdict.state) || 'unprobed'; tally[s] = (tally[s] || 0) + 1; });
      const alive = tally.alive || 0;
      const parts = Object.keys(tally).sort().map((k) => tally[k] + ' ' + k).join(' · ');
      statusEl.innerHTML = `ghosts · ${rooms.length}/${ghostTotal} ${ghostLabel[ghostFilter]}` + (parts ? ' · ' + parts : '') +
        (alive ? ` <span style="color:#7f7">← ${alive} still enterable</span>` : '') +
        ` · watch ${watching ? 'ON' : 'off'}${AUTO_PROBE ? '' : ' · auto-probe off'}`;
      return;
    }
    const pins = rooms.filter((r) => PIN.includes((r.countryCode || '').toUpperCase())).length;
    const flag = lastFlagged[activeTab] ? ` · ${lastFlagged[activeTab]} inLive=false` : '';
    statusEl.textContent = `${activeTab} · ${rooms.length} rooms · ${pins} pinned · ${favorites.size} ★${flag}${watching ? ' · 👁' : ''}`;
  }

  let loadTries = 0;
  async function loadTab(force) {
    if (activeTab === 'favorites') { renderList(); if (force) checkFavorites(true); return; }
    if (activeTab === 'ghosts') { renderList(); return; }
    if (!Object.keys(capturedHeaders).length) {
      loadTries++;
      statusEl.textContent = loadTries > 8
        ? '⚠ no auth headers seen yet — click a room on the site once, then ⟳'
        : 'learning auth headers from the site… (' + loadTries + ')';
      clearTimeout(loadTab._t); loadTab._t = setTimeout(() => loadTab(force), 1500);
      return;
    }
    loadTries = 0;
    if (force) cache[activeTab] = null;
    if (cache[activeTab]) { rooms = cache[activeTab]; renderList(); return; }
    statusEl.textContent = activeTab === 'premium' ? 'enumerating premium…'
      : activeTab === 'faves' ? 'loading ' + FAVE_COUNTRIES.join('/') + '…' : 'loading all rooms…';
    try {
      rooms = await scanTab(activeTab);
      renderList();
    } catch (e) {
      statusEl.textContent = '⚠ ' + e.message;
      console.error('[ti-rooms]', e);
    }
  }

  function dragify(el, handle) {
    let sx, sy, ox, oy, drag = false;
    handle.addEventListener('mousedown', (e) => {
      if (e.target.tagName === 'BUTTON') return;
      drag = true; sx = e.clientX; sy = e.clientY;
      const r = el.getBoundingClientRect(); ox = r.left; oy = r.top; e.preventDefault();
    });
    window.addEventListener('mousemove', (e) => { if (!drag) return; el.style.left = ox + (e.clientX - sx) + 'px'; el.style.top = oy + (e.clientY - sy) + 'px'; });
    window.addEventListener('mouseup', () => { drag = false; });
  }

  // A tile reporting the host left is the one unambiguous "really ended"
  // signal we get — note it so ghosts can be told apart from dead rooms.
  window.addEventListener('message', (e) => {
    const m = e.data || {};
    if (m && m.type === 'ti-ended' && m.roomId) {
      const reg = registry.get(String(m.roomId));
      if (reg) { push(reg, 'stream ended: ' + (m.why || '?')); console.log('[ti-ghost] stream ended', m.roomId, m.why); }
    }
  });

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', buildUI);
  else buildUI();
})();
