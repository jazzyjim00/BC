      '.nm{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}' +
      '.cnt{color:#8c8}' +
      '.mb{background:#0006;color:#fff;border:0;border-radius:5px;padding:2px 7px;cursor:pointer;font-size:13px}' +
      '.hit{position:absolute;inset:0;z-index:2;cursor:pointer}' +
      '.st{position:absolute;inset:0;z-index:4;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:#bbb;background:#0008;cursor:pointer}' +
      '.st u{color:#6cf}' +
      '</style></head><body><div id="grid"></div><script>' + inner + '<\/script></body></html>';
  }

  // ---- UI -----------------------------------------------------------------
  let box, listEl, statusEl, tabBar, rooms = [];
  let activeTab = 'regular';
  const cache = { regular: null, premium: null, faves: null };
  const lastFlagged = { regular: 0, premium: 0, faves: 0 };
  const tabBtns = {};
  const roomById = new Map();
  let watching = false, watchTimer = null, watchBtn = null;
  // ---- favourites ---------------------------------------------------------
  // The star on each row. We keep the whole payload, not just the id, so a
  // favourite is still playable once it has dropped off every list — which is
  // the entire point of the tab. Persisted so they survive a reload.
  const FAVE_KEY = 'tiRoomFavorites';
  const favorites = new Map();       // rid -> last known room payload
  const faveState = new Map();       // rid -> { state, why }  (enterability)
  let faveChecking = false;

  function loadFavorites() {
    try { (JSON.parse(localStorage.getItem(FAVE_KEY) || '[]') || []).forEach((r) => favorites.set(rid(r), r)); }
    catch (e) { console.warn('[ti-rooms] could not read favourites', e.message); }
  }
  function saveFavorites() {
    try { localStorage.setItem(FAVE_KEY, JSON.stringify([...favorites.values()])); }
    catch (e) { console.warn('[ti-rooms] could not save favourites', e.message); }
  }
  function toggleFave(r) {
    const id = rid(r);
    if (favorites.has(id)) { favorites.delete(id); faveState.delete(id); }
    else favorites.set(id, { ...r });
    saveFavorites();
    renderList();
  }

  // ---- favourite import / export -----------------------------------------
  // Exports the whole stored payload per favourite, not just ids: an id alone
  // is useless once a room has dropped off every list, which is exactly when
  // you want your list back. Versioned envelope so a later format change is
  // detected rather than silently mis-parsed.
  const FAVE_FORMAT = 'ti.live-favorites';
  const FAVE_VERSION = 1;

  const faveEnvelope = () => ({
    format: FAVE_FORMAT, version: FAVE_VERSION,
    exportedAt: new Date().toISOString(),
    count: favorites.size,
    rooms: [...favorites.values()],
  });

  function exportFavorites() {
    if (!favorites.size) { flashFaveNote('nothing to export'); return; }
    const stamp = new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-');
    const url = URL.createObjectURL(new Blob([JSON.stringify(faveEnvelope(), null, 2)], { type: 'application/json' }));
    const a = document.createElement('a');
    a.href = url; a.download = 'ti-favorites-' + stamp + '.json';
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 10000);
    flashFaveNote('exported ' + favorites.size);
  }

  // Accepts our own envelope, a bare array, or {rooms|favorites|list:[…]} —
  // a hand-edited or older file shouldn't need a converter.
  function parseFaveFile(text) {
    let d;
    try { d = JSON.parse(text); } catch (e) { throw new Error('not valid JSON — ' + e.message); }
    const arr = Array.isArray(d) ? d
      : (d && Array.isArray(d.rooms)) ? d.rooms
      : (d && Array.isArray(d.favorites)) ? d.favorites
      : (d && Array.isArray(d.list)) ? d.list : null;
    if (!arr) throw new Error('no room array found (expected {rooms:[…]} or a bare array)');
    const rooms = arr.filter((r) => r && typeof r === 'object' && hasId(r));
    if (!rooms.length) throw new Error(arr.length + ' entries, none with a roomId');
    return { rooms, skipped: arr.length - rooms.length };
  }

  function importFavorites(text, replace) {
    const { rooms, skipped } = parseFaveFile(text);
    if (replace) { favorites.clear(); faveState.clear(); }
    let added = 0, updated = 0;
    rooms.forEach((r) => {
      const id = rid(r);
      if (favorites.has(id)) updated++; else added++;
      // Merge lets what we already hold win: an imported payload can be months
      // old, and a room we've scanned this session has fresher fields. The
      // import fills gaps rather than overwriting live data.
      favorites.set(id, replace ? { ...r } : { ...r, ...favorites.get(id) });
      faveState.delete(id);   // enterability is per-session — re-check it
    });
    saveFavorites();
    renderList();
    checkFavorites(true);
    return { added, updated, skipped };
  }

  function pickFaveFile(replace) {
    const inp = document.createElement('input');
    inp.type = 'file';
    inp.accept = '.json,application/json';
    inp.style.display = 'none';
    inp.onchange = () => {
      const f = inp.files && inp.files[0];
      inp.remove();
      if (!f) return;
      const fr = new FileReader();
      fr.onload = () => {
        try {
          const res = importFavorites(String(fr.result), replace);
          flashFaveNote((replace ? 'replaced · ' : '') + res.added + ' new · ' + res.updated + ' already had'
            + (res.skipped ? ' · ' + res.skipped + ' skipped' : ''));
        } catch (e) { flashFaveNote('⚠ ' + e.message); console.warn('[ti-faves] import failed', e); }
      };
      fr.onerror = () => flashFaveNote('⚠ could not read file');
      fr.readAsText(f);
    };
    document.body.appendChild(inp);
    inp.click();
  }

  // Import/export feedback shares the control row's note slot, so it doesn't
  // need its own line in a 360px panel.
  let faveNote = '', faveNoteTimer = null;
  function flashFaveNote(msg) {
    faveNote = msg;
    clearTimeout(faveNoteTimer);
    faveNoteTimer = setTimeout(() => { faveNote = ''; refreshFaves(); }, 6000);
    refreshFaves();
  }

  // Ask each favourite whether it can still be entered. Serialised, and rooms
  // already playing in one of our windows are reported without an enter call —
  // rejoining would put our viewer uid in the channel twice.
  async function checkFavorites(force) {
    if (faveChecking) return;
    faveChecking = true;
    try {
      for (const [id, r] of [...favorites]) {
        if (!force && faveState.has(id) && faveState.get(id).state !== 'checking') continue;
        if (openRooms.has(id)) { faveState.set(id, { state: 'open', why: 'in a player window' }); refreshFaves(); continue; }
        faveState.set(id, { state: 'checking', why: '' });
        refreshFaves();
        let enter = null, err = null;
        try { enter = await api(`/video_living/${id}/enter`, { method: 'POST', params: { support_trtc: true } }); }
        catch (ex) { err = ex.message; }
        const rv = (enter && enter.roomVo) || null;
        const rtc = !!(enter && enter.rtcAppId);
        let st;
        if (err) st = { state: 'dead', why: err };
        else if (rv && rv.inLive === false) st = { state: 'ended', why: 'inLive=false' };
        else if (rtc) st = { state: 'enterable', why: rv && rv.onlineCount != null ? '👤 ' + rv.onlineCount : 'rtc creds' };
        else st = { state: 'unclear', why: 'enter ok, no rtc creds' };
        // Refresh the stored payload while we have a fresh one.
        if (rv) { favorites.set(id, { ...r, ...rv }); saveFavorites(); }
        faveState.set(id, st);
        refreshFaves();
        await new Promise((res) => setTimeout(res, 800));
      }
    } finally { faveChecking = false; refreshFaves(); }
  }
  function refreshFaves() { if (activeTab === 'favorites' && statusEl) renderList(); }

  const FAVE_RANK = { enterable: 0, open: 0, unclear: 1, checking: 2, ended: 3, dead: 4 };
  function favoriteRooms() {
    const rank = (r) => {
      const s = faveState.get(rid(r));
      return s && FAVE_RANK[s.state] != null ? FAVE_RANK[s.state] : 2;
    };
    return [...favorites.values()].sort((a, b) => rank(a) - rank(b) || (b.onlineCount || 0) - (a.onlineCount || 0));
  }

  // Ghosts tab: most vanished rooms are from countries we don't care about.
  // Three-way filter, cycled by the toggle at the top of the tab.
  const GHOST_FILTERS = ['pinned', 'faves', 'all'];
  const ghostMatch = {
    pinned: (r) => PIN.includes((r.countryCode || '').toUpperCase()),
    faves: (r) => FAVE_COUNTRIES.includes((r.countryCode || '').toUpperCase()),
    all: () => true,
  };
  const ghostLabel = { pinned: '★ pinned', faves: '♥ ' + FAVE_COUNTRIES.join('·'), all: '☆ all' };
  let ghostFilter = 'pinned', ghostHiddenCount = 0, ghostTotal = 0;

  const ago = (t) => {
    const s = Math.max(0, Math.round((Date.now() - t) / 1000));
    return s < 60 ? s + 's' : s < 3600 ? Math.round(s / 60) + 'm' : (s / 3600).toFixed(1) + 'h';
  };

  function buildUI() {
    loadFavorites();
    box = document.createElement('div');
    box.style.cssText = 'position:fixed;top:10px;left:10px;width:360px;max-height:88vh;display:flex;flex-direction:column;z-index:2147483647;background:#141414;color:#eee;font:13px/1.4 system-ui,sans-serif;border:1px solid #333;border-radius:10px;box-shadow:0 6px 26px rgba(0,0,0,.6)';

    const head = document.createElement('div');
    head.style.cssText = 'display:flex;gap:6px;align-items:center;padding:8px 10px;background:#1c1c1c;border-bottom:1px solid #2a2a2a;border-radius:10px 10px 0 0;cursor:move';
    head.innerHTML = '<b style="color:#6cf;flex:1">ti.live rooms</b>';
    const mk = (t, fn, extra) => { const b = document.createElement('button'); b.textContent = t; b.style.cssText = 'font:12px system-ui;background:#2b2b2b;color:#eee;border:1px solid #444;border-radius:6px;padding:3px 8px;cursor:pointer;' + (extra || ''); b.onclick = fn; return b; };
    head.appendChild(mk('⟳', () => loadTab(true), 'font-size:14px'));
    watchBtn = mk('👁', () => setWatch(!watching), 'font-size:13px');
    watchBtn.title = 'watch mode: re-scan every list every ' + Math.round(POLL_MS / 1000) + 's and track rooms that vanish';
    head.appendChild(watchBtn);
    head.appendChild(mk('grid 6', () => openPlayers(pickForGrid()), 'background:#164a2a;border-color:#2a6'));
    head.appendChild(mk('▾', () => { const h = listEl.style.display === 'none'; listEl.style.display = h ? 'block' : 'none'; }));

    // tab bar
    tabBar = document.createElement('div');
    tabBar.style.cssText = 'display:flex;border-bottom:1px solid #2a2a2a';
