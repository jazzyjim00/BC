// ==UserScript==
// @name         ti.live Room Board (direct stream + 6-up grid)
// @namespace    https://app.ti.live/
// @version      5.7
// @description  Signs api.ti.live requests (reverse-engineered CheckSum), lists ALL live rooms sorted by online count (US/UA/RU pinned), plays streams DIRECTLY (Agora subscribe for rtcProvide 1, Tencent TRTC for rtcProvide 2) room-by-room or as a 6-up grid (blob window). Tile click pops out. Ghost tracking keeps rooms that vanish from the listings, shows rooms the API flags inLive=false, and probes ghosts to see which are still enterable. Favourites import/export as JSON.
// @match        https://app.ti.live/*
// @run-at       document-start
// @grant        none
// ==/UserScript==

(function () {
  'use strict';

  // ========================================================================
  // CONFIG
  // ========================================================================
  const API      = 'https://api.ti.live/vchat/app';
  const PIN      = ['US', 'UA', 'RU','AD','AT','AU','BE','BG','BY','CA','CH','CO','CY','CZ','DE','DK','EE','ES','FI','FR','GR','HR','HU','IE','IS','IT','LI','LT','LU','LV','MC','MD','ME','MK','MT','NL','NO','NZ','PL','PT','RO','RS','SE','SI','SK','SM','VA'];   // countries pinned to the top
  const FAVE_COUNTRIES = ['US', 'UA', 'RU', 'GB'];   // the country-filter tab
  const PAGE_SZ  = 20;
  const MAX_PAGE = 40;
  const GRID_N   = 6;
  const POLL_MS  = 45000;          // watch mode: full re-scan of every list
  const GHOST_TTL = 45 * 60 * 1000; // forget ghosts after this long
  const MISS_STRIKES = 2;          // consecutive absences before calling it gone
  // Auto-probe: the moment a room becomes a ghost, call /enter once to find out
  // whether it's still alive-but-unlisted or simply over. Costs one enter call
  // per vanished room — the server may count that as a view. Set false to make
  // probing manual (the 🔍 button) only.
  const AUTO_PROBE = true;
  const PROBE_GAP_MS = 1500;       // serialise probes so we don't burst the API
  // After a probe says a ghost is still alive, hunt for the list it moved to.
  const AUTO_LOCATE = true;
  // Fallback: open the site's own room page (used when a room has no direct URL).
  const ROOM_PAGE = (r) => `https://app.ti.live/video-room?room_id=${r.roomId}&uid=${r.uid}`;

  // ---- auth: replicate the site's request signature -----------------------
  // Reverse-engineered from app.b75e4093.js. api.ti.live requires a per-request
  // CheckSum header:
  //   base = "https://api.ti.live/vchat"
  //   u    = base + "/app"+endpoint + ("?"+serialize(params) if params)
  //          + (body ? md5(JSON.stringify(body)) : "") + timestamp + userId + token.slice(0,6)
  //   CheckSum = md5(u)          (js-md5)   timestamp = Date.now()+""
  // serialize = Object.entries → encodeURIComponent(k)+"="+encodeURIComponent(v), join("&").
  // Other required headers (deviceId, channel, bundleId, appVersion, gender:1,
  // serverVersion:6, …) are sniffed from the site's own calls.
  const SIGN_BASE = 'https://api.ti.live/vchat';
  const cookie = (n) => { const m = document.cookie.match('(^|;)\\s*' + n + '\\s*=\\s*([^;]+)'); return m ? m[2] : ''; };
  const serialize = (p) => Object.entries(p).map(([k, v]) => encodeURIComponent(k) + '=' + encodeURIComponent(v == null ? '' : v)).join('&');

  // blueimp md5 (MIT) — byte-identical output to the site's js-md5.
  function md5(str) {
    function sa(x, y) { const l = (x & 0xFFFF) + (y & 0xFFFF); return (((x >> 16) + (y >> 16) + (l >> 16)) << 16) | (l & 0xFFFF); }
    function rl(n, c) { return (n << c) | (n >>> (32 - c)); }
    function cmn(q, a, b, x, s, t) { return sa(rl(sa(sa(a, q), sa(x, t)), s), b); }
    function ff(a, b, c, d, x, s, t) { return cmn((b & c) | (~b & d), a, b, x, s, t); }
    function gg(a, b, c, d, x, s, t) { return cmn((b & d) | (c & ~d), a, b, x, s, t); }
    function hh(a, b, c, d, x, s, t) { return cmn(b ^ c ^ d, a, b, x, s, t); }
    function ii(a, b, c, d, x, s, t) { return cmn(c ^ (b | ~d), a, b, x, s, t); }
    function bin(x, len) {
      x[len >> 5] |= 0x80 << (len % 32); x[(((len + 64) >>> 9) << 4) + 14] = len;
      let a = 1732584193, b = -271733879, c = -1732584194, d = 271733878;
      for (let i = 0; i < x.length; i += 16) {
        const oa = a, ob = b, oc = c, od = d;
        a = ff(a, b, c, d, x[i], 7, -680876936); d = ff(d, a, b, c, x[i + 1], 12, -389564586); c = ff(c, d, a, b, x[i + 2], 17, 606105819); b = ff(b, c, d, a, x[i + 3], 22, -1044525330);
        a = ff(a, b, c, d, x[i + 4], 7, -176418897); d = ff(d, a, b, c, x[i + 5], 12, 1200080426); c = ff(c, d, a, b, x[i + 6], 17, -1473231341); b = ff(b, c, d, a, x[i + 7], 22, -45705983);
        a = ff(a, b, c, d, x[i + 8], 7, 1770035416); d = ff(d, a, b, c, x[i + 9], 12, -1958414417); c = ff(c, d, a, b, x[i + 10], 17, -42063); b = ff(b, c, d, a, x[i + 11], 22, -1990404162);
        a = ff(a, b, c, d, x[i + 12], 7, 1804603682); d = ff(d, a, b, c, x[i + 13], 12, -40341101); c = ff(c, d, a, b, x[i + 14], 17, -1502002290); b = ff(b, c, d, a, x[i + 15], 22, 1236535329);
        a = gg(a, b, c, d, x[i + 1], 5, -165796510); d = gg(d, a, b, c, x[i + 6], 9, -1069501632); c = gg(c, d, a, b, x[i + 11], 14, 643717713); b = gg(b, c, d, a, x[i], 20, -373897302);
        a = gg(a, b, c, d, x[i + 5], 5, -701558691); d = gg(d, a, b, c, x[i + 10], 9, 38016083); c = gg(c, d, a, b, x[i + 15], 14, -660478335); b = gg(b, c, d, a, x[i + 4], 20, -405537848);
        a = gg(a, b, c, d, x[i + 9], 5, 568446438); d = gg(d, a, b, c, x[i + 14], 9, -1019803690); c = gg(c, d, a, b, x[i + 3], 14, -187363961); b = gg(b, c, d, a, x[i + 8], 20, 1163531501);
        a = gg(a, b, c, d, x[i + 13], 5, -1444681467); d = gg(d, a, b, c, x[i + 2], 9, -51403784); c = gg(c, d, a, b, x[i + 7], 14, 1735328473); b = gg(b, c, d, a, x[i + 12], 20, -1926607734);
        a = hh(a, b, c, d, x[i + 5], 4, -378558); d = hh(d, a, b, c, x[i + 8], 11, -2022574463); c = hh(c, d, a, b, x[i + 11], 16, 1839030562); b = hh(b, c, d, a, x[i + 14], 23, -35309556);
        a = hh(a, b, c, d, x[i + 1], 4, -1530992060); d = hh(d, a, b, c, x[i + 4], 11, 1272893353); c = hh(c, d, a, b, x[i + 7], 16, -155497632); b = hh(b, c, d, a, x[i + 10], 23, -1094730640);
        a = hh(a, b, c, d, x[i + 13], 4, 681279174); d = hh(d, a, b, c, x[i], 11, -358537222); c = hh(c, d, a, b, x[i + 3], 16, -722521979); b = hh(b, c, d, a, x[i + 6], 23, 76029189);
        a = hh(a, b, c, d, x[i + 9], 4, -640364487); d = hh(d, a, b, c, x[i + 12], 11, -421815835); c = hh(c, d, a, b, x[i + 15], 16, 530742520); b = hh(b, c, d, a, x[i + 2], 23, -995338651);
        a = ii(a, b, c, d, x[i], 6, -198630844); d = ii(d, a, b, c, x[i + 7], 10, 1126891415); c = ii(c, d, a, b, x[i + 14], 15, -1416354905); b = ii(b, c, d, a, x[i + 5], 21, -57434055);
        a = ii(a, b, c, d, x[i + 12], 6, 1700485571); d = ii(d, a, b, c, x[i + 3], 10, -1894986606); c = ii(c, d, a, b, x[i + 10], 15, -1051523); b = ii(b, c, d, a, x[i + 1], 21, -2054922799);
        a = ii(a, b, c, d, x[i + 8], 6, 1873313359); d = ii(d, a, b, c, x[i + 15], 10, -30611744); c = ii(c, d, a, b, x[i + 6], 15, -1560198380); b = ii(b, c, d, a, x[i + 13], 21, 1309151649);
        a = ii(a, b, c, d, x[i + 4], 6, -145523070); d = ii(d, a, b, c, x[i + 11], 10, -1120210379); c = ii(c, d, a, b, x[i + 2], 15, 718787259); b = ii(b, c, d, a, x[i + 9], 21, -343485551);
        a = sa(a, oa); b = sa(b, ob); c = sa(c, oc); d = sa(d, od);
      }
      return [a, b, c, d];
    }
    function b2r(inp) { let o = ''; for (let i = 0; i < inp.length * 32; i += 8) o += String.fromCharCode((inp[i >> 5] >>> (i % 32)) & 0xFF); return o; }
    function r2b(inp) { const o = []; o[(inp.length >> 2) - 1] = undefined; for (let i = 0; i < o.length; i++) o[i] = 0; for (let i = 0; i < inp.length * 8; i += 8) o[i >> 5] |= (inp.charCodeAt(i / 8) & 0xFF) << (i % 32); return o; }
    function r2h(inp) { const h = '0123456789abcdef'; let o = ''; for (let i = 0; i < inp.length; i++) { const x = inp.charCodeAt(i); o += h.charAt((x >>> 4) & 0x0F) + h.charAt(x & 0x0F); } return o; }
    const s = unescape(encodeURIComponent(str));
    return r2h(b2r(bin(r2b(s), s.length * 8)));
  }

  // Sniff the site's non-auth headers (deviceId, channel, bundleId, appVersion…).
  const capturedHeaders = {};
  const FORBIDDEN = new Set(['host', 'connection', 'content-length', 'origin', 'referer', 'user-agent',
    'cookie', 'date', 'accept-encoding', 'accept-charset', 'dnt', 'te', 'trailer', 'transfer-encoding',
    'upgrade', 'keep-alive', 'via', 'proxy-authorization', 'expect', 'checksum', 'timestamp']);
  const skippable = (k) => FORBIDDEN.has(k) || k.startsWith('sec-') || k.startsWith('proxy-');
  const isApi = (u) => typeof u === 'string' && u.indexOf('api.ti.live') > -1;
  function grab(k, v) { const kk = String(k).toLowerCase(); if (!skippable(kk) && v != null && v !== '') capturedHeaders[kk] = v; }

  // Every distinct api.ti.live path the site itself calls. If rooms are moving
  // to a listing we don't know about, its endpoint shows up here the first time
  // the site's own UI asks for it — watch the console for [ti-sniff].
  const seenEndpoints = new Map();
  function noteEndpoint(method, url) {
    try {
      if (!isApi(String(url))) return;
      const u = new URL(url, location.href);
      const key = (method || 'GET').toUpperCase() + ' ' + u.pathname;
      if (!seenEndpoints.has(key)) {
        seenEndpoints.set(key, u.search || '');
        console.log('[ti-sniff] new endpoint', key, u.search || '');
      }
    } catch (e) {}
  }
  window.__tiEndpoints = seenEndpoints;

  (function installSniffer() {
    const of = window.fetch;
    window.fetch = function (input, init) {
      try {
        const url = typeof input === 'string' ? input : (input && input.url) || '';
        noteEndpoint((init && init.method) || (typeof input !== 'string' && input && input.method) || 'GET', url);
        let h = (init && init.headers) || (typeof input !== 'string' && input && input.headers);
        if (isApi(url) && h) {
          if (h instanceof Headers) h.forEach((v, k) => grab(k, v));
          else if (Array.isArray(h)) h.forEach(([k, v]) => grab(k, v));
          else Object.keys(h).forEach((k) => grab(k, h[k]));
        }
      } catch (e) {}
      return of.apply(this, arguments);
    };
    const oOpen = XMLHttpRequest.prototype.open;
    const oSet = XMLHttpRequest.prototype.setRequestHeader;
    XMLHttpRequest.prototype.open = function (m, u) { this.__tiUrl = u; try { noteEndpoint(m, u); } catch (e) {} return oOpen.apply(this, arguments); };
    XMLHttpRequest.prototype.setRequestHeader = function (k, v) { try { if (isApi(this.__tiUrl)) grab(k, v); } catch (e) {} return oSet.apply(this, arguments); };
  })();
  window.__tiHeaders = capturedHeaders;

  // endpoint = path after "/app", e.g. "/video_living/rooms/v2". opts.params is
  // an object; opts.data (rare) becomes a JSON body.
  async function api(endpoint, opts) {
    opts = opts || {};
    const method = (opts.method || 'GET').toUpperCase();
    const params = opts.params;
    const data = opts.data;
    const aurl = '/app' + endpoint;
    const qs = params ? serialize(params) : '';
    const ts = Date.now() + '';
    const bodyHash = data != null ? md5(JSON.stringify(data)) : '';
    const userId = cookie('userId') || capturedHeaders['userid'] || '';
    const token = cookie('token') || capturedHeaders['token'] || '';
    let u = SIGN_BASE + aurl + (qs ? '?' + qs : '') + bodyHash + ts;
    if (userId) u += userId;
    if (token) u += token.slice(0, 6);
    const CheckSum = md5(u);
    const reqUrl = SIGN_BASE + aurl + (qs ? '?' + qs : '');
    const headers = { ...capturedHeaders, checksum: CheckSum, timestamp: ts };
    if (userId && !headers['userid']) headers['userid'] = userId;
    if (token && !headers['token']) headers['token'] = token;
    let res;
    try {
      res = await fetch(reqUrl, {
        method, credentials: 'omit', headers,
        body: method === 'GET' ? undefined : (data != null ? JSON.stringify(data) : ''),
      });
    } catch (netErr) {
      throw new Error('network/CORS on ' + endpoint + ' — ' + netErr.message);
    }
    const json = await res.json();
    if (json.status !== 200) throw new Error(endpoint + ' → ' + json.status + ' ' + json.message);
    return json.data;
  }

  // ---- room list ----------------------------------------------------------
  const rid = (r) => r.strRoomId || String(r.roomId);
  const dedupe = (arr) => { const m = new Map(); arr.forEach((r) => m.set(rid(r), { ...m.get(rid(r)), ...r })); return [...m.values()]; };

  // Walk pages in concurrent batches until hasMore is false (or the cap is hit).
  // We can't know the page count up front (the API only returns hasMore), so we
  // fire BATCH pages at once and stop after the batch that reaches the end —
  // overfetching at most BATCH-1 empty pages, which dedupe discards.
  // NOTE: the server re-sorts by online count while we walk, so a room can slip
  // across a page boundary and be missed by a scan. That's why a single absence
  // never marks a room gone — see MISS_STRIKES.
  // Why the walk stopped matters: a server that truncates a ranked list will
  // report hasMore:false at a suspiciously round total, and rooms drop off the
  // bottom as their viewer count falls — no flag flips, no list changes, they
  // are simply ranked out. walkStats records the evidence.
  const walkStats = {};
  const PAGE_BATCH = 6;
  async function fetchAllPages(endpoint, makeParams, cap, statKey) {
    const out = [];
    const CAP = cap || 40;
    let page = 1, done = false, pages = 0, errors = 0, ended = 'cap';
    while (!done && page <= CAP) {
      const batch = [];
      for (let i = 0; i < PAGE_BATCH && page <= CAP; i++, page++) batch.push(page);
      // One retry per page. A page that fails must NOT end the walk — the old
      // code treated a null result as end-of-list, so a single failed request
      // silently truncated the enumeration and every page after it was never
      // fetched. That alone could hide arbitrary rooms from the board.
      const results = await Promise.all(batch.map(async (p) => {
        for (let attempt = 0; attempt < 2; attempt++) {
          try { return { p, d: await api(endpoint, { params: makeParams(p) }) }; }
          catch (e) {
            if (attempt) { errors++; console.warn('[ti-rooms] page', p, 'failed twice on', endpoint, e.message); return { p, d: null }; }
            await new Promise((r) => setTimeout(r, 300));
          }
        }
      }));
      results.sort((a, b) => a.p - b.p);
      for (const { d } of results) {
        const rooms = (d && d.rooms) || [];
        out.push(...rooms);
        if (d) pages++;
        // Only a page that actually reports the end stops the walk.
        if (d && (!d.hasMore || rooms.length === 0)) {
          done = true; ended = rooms.length ? 'hasMore:false' : 'empty page';
          break;
        }
      }
    }
    if (errors) ended += ' · ' + errors + ' page(s) failed';
    if (statKey) walkStats[statKey] = { pages, ended, errors, raw: out.length, cap: CAP };
    return out;
  }

  // Regular tab: the full live list, enumerated.
  async function fetchRegular() {
    return dedupe(await fetchAllPages('/video_living/rooms/v2', (page) => ({ page, size: PAGE_SZ, countryFilter: '' }), 60, 'regular'));
  }

  // Premium tab: enumerate all premium pages.
  async function fetchPremium() {
    return dedupe(await fetchAllPages('/video_living/premium/rooms/', (page) => ({ page, size: PAGE_SZ }), 60, 'premium'))
      .map((r) => ({ ...r, isPremium: true }));
  }

  // Country tab: enumerate each of FAVE_COUNTRIES via countryFilter, merged.
  async function fetchFaves() {
    const per = await Promise.all(FAVE_COUNTRIES.map((c) =>
      fetchAllPages('/video_living/rooms/v2', (page) => ({ page, size: PAGE_SZ, countryFilter: c }), 30).catch(() => [])));
    return dedupe(per.flat());
  }

  function sortRooms(rooms) {
    const rank = (r) => { const i = PIN.indexOf((r.countryCode || '').toUpperCase()); return i === -1 ? PIN.length : i; };
    return rooms.slice().sort((a, b) => rank(a) - rank(b) || (b.onlineCount || 0) - (a.onlineCount || 0));
  }

  // ========================================================================
  // ROOM REGISTRY / GHOST TRACKING
  // ========================================================================
  // Rooms drop off the public listings while their RTC channel keeps running —
  // an already-joined tile keeps playing long after the room is unlistable. To
  // find out *why*, we keep the last raw payload for every room we've ever seen
  // and diff it against every later sighting (and against what /enter reports
  // once the room is gone). The field that flips is the answer.
  //
  //   registry: rid -> {
  //     id, last, first, lastSeen,
  //     seenIn:  { tab: ts }     tabs this room has ever appeared in
  //     miss:    { tab: n }      consecutive scans of that tab without it
  //     goneFrom:{ tab: ts }     when it hit MISS_STRIKES in that tab
  //     history: [{ t, ev, diff, raw, err }]
  //   }
  const registry = new Map();

  // Volatile fields — they churn every scan and would drown the real signal.
  const SKIP_DIFF = new Set(['onlineCount', 'frontImage', 'avatar', 'timestamp', 'ts',
    'hotValue', 'heat', 'rank', 'sort', 'sortValue', 'distance', 'lastActiveTime', 'updateTime']);

  function diffRooms(a, b) {
    if (!a || !b) return [];
    const out = [];
    const keys = new Set([...Object.keys(a), ...Object.keys(b)]);
    for (const k of keys) {
      if (SKIP_DIFF.has(k)) continue;
      const x = a[k], y = b[k];
      if ((x && typeof x === 'object') || (y && typeof y === 'object')) continue;
      if (x !== y) out.push(k + ': ' + JSON.stringify(x) + ' → ' + JSON.stringify(y));
    }
    return out;
  }

  function push(e, ev, extra) {
    e.history.push({ t: Date.now(), ev, ...(extra || {}) });
    if (e.history.length > 40) e.history.splice(0, e.history.length - 40);
  }

  function noteSeen(r, tab, stamp, note) {
    const id = rid(r);
    let e = registry.get(id);
    if (!e) {
      e = { id, first: stamp, seenIn: {}, miss: {}, goneFrom: {}, history: [], last: null };
      registry.set(id, e);
      push(e, 'first seen in ' + tab + (note ? ' (' + note + ')' : ''));
    }
    if (e.goneFrom[tab]) {
      const gap = Math.round((stamp - e.goneFrom[tab]) / 1000);
      push(e, 'reappeared in ' + tab + ' after ' + gap + 's', { diff: diffRooms(e.last, r) });
      console.log('[ti-ghost] reappeared in', tab, id, 'after', gap + 's', diffRooms(e.last, r));
      delete e.goneFrom[tab];
      e.probed = false; e.verdict = null;   // re-probe if it vanishes again
    } else if (e.last) {
      const d = diffRooms(e.last, r);
      if (d.length) push(e, 'changed in ' + tab, { diff: d });
    }
    // The exact moment a room is hidden while still being returned by the API.
    // This is the transition worth catching: the room does not leave, it gets
    // flagged — which looks identical to "disappeared" from the UI.
    if (e.last && e.last.inLive !== false && r.inLive === false) {
      push(e, 'HIDDEN: inLive true→false in ' + tab + ' at ' + (r.onlineCount || 0) + ' viewers');
      console.log('%c[ti-ghost] HIDDEN (inLive true→false)', 'color:#e0b060;font-weight:bold', id,
        (r.roomName || r.nickname || ''), r.onlineCount + ' viewers', diffRooms(e.last, r));
    }
    if (note) push(e, note + ' in ' + tab);
    e.last = r;
    e.lastSeen = stamp;
    e.seenIn[tab] = stamp;
    e.miss[tab] = 0;
    return e;
  }

  // A ghost is a room that has gone missing from every list it used to be in.
  const isGhost = (e) => {
    const tabs = Object.keys(e.seenIn);
    return tabs.length > 0 && tabs.every((t) => e.goneFrom[t]);
  };
  const goneAt = (e) => Math.max(...Object.values(e.goneFrom).map(Number), 0);

  // Verdict order: the interesting ones (alive, or not yet judged) float to the
  // top; confirmed-ended rooms sink. Within a band, most recently gone first.
  const VERDICT_RANK = { moved: 0, alive: 1, unclear: 2, probing: 3, queued: 3, dead: 4, ended: 5 };
  const vrank = (e) => (e.verdict ? (VERDICT_RANK[e.verdict.state] != null ? VERDICT_RANK[e.verdict.state] : 3) : 3);

  function ghosts() {
    const now = Date.now();
    const out = [];
    registry.forEach((e, id) => {
      if (!isGhost(e)) return;
      if (now - goneAt(e) > GHOST_TTL) { registry.delete(id); return; }
      out.push(e);
    });
    return out.sort((a, b) => vrank(a) - vrank(b) || goneAt(b) - goneAt(a));
  }

  const TABS = ['regular', 'premium', 'faves'];
  const fetchers = { regular: fetchRegular, premium: fetchPremium, faves: fetchFaves };

  // One scan of one list. Feeds the registry, ages out absent rooms, and
  // refreshes that tab's cache.
  async function scanTab(tab) {
    const raw = await fetchers[tab]();
    const stamp = Date.now();
    const live = raw.filter((r) => r.inLive !== false);
    // Rooms the API still returns but flags as not-live. The old build dropped
    // these on the floor; they're a prime suspect for "vanished but streaming".
    const flagged = raw.filter((r) => r.inLive === false);

    const present = new Set();
    live.forEach((r) => { present.add(rid(r)); noteSeen(r, tab, stamp); });
    flagged.forEach((r) => { present.add(rid(r)); noteSeen(r, tab, stamp, 'inLive=false'); });

    registry.forEach((e) => {
      if (!e.seenIn[tab] || present.has(e.id) || e.goneFrom[tab]) return;
      e.miss[tab] = (e.miss[tab] || 0) + 1;
      if (e.miss[tab] >= MISS_STRIKES) {
        e.goneFrom[tab] = stamp;
        push(e, 'vanished from ' + tab + ' at ' + ((e.last && e.last.onlineCount) || 0) + ' viewers');
        const where = TABS.filter((t) => t !== tab && e.seenIn[t] && !e.goneFrom[t]);
        console.log('[ti-ghost] vanished from', tab, e.id,
          (e.last && (e.last.roomName || e.last.nickname)) || '',
          where.length ? 'still in: ' + where.join(',') : 'GONE FROM ALL LISTS', e.last);
        // Off every list it was in → it's a ghost now; find out if it's alive.
        if (AUTO_PROBE && isGhost(e)) queueProbe(e);
      }
    });

    // Show the flagged rooms instead of dropping them. A room the API still
    // returns with inLive:false is exactly the "gone from the list but still
    // streaming" case — hiding it here made our board complicit in whatever
    // the server was doing.
    const sorted = sortRooms(live).concat(sortRooms(flagged).map((r) => ({ ...r, __hidden: true })));
    cache[tab] = sorted;
    sorted.forEach((r) => roomById.set(rid(r), r));
    lastFlagged[tab] = flagged.length;
    return sorted;
  }

  // Ask the room itself what it thinks it is now, and diff that against the
  // last listing payload. enter's roomVo is the same shape as a list row, so
  // the diff points straight at whatever field hides a room.
  async function probeGhost(e) {
    let enter = null, err = null;
    try { enter = await api(`/video_living/${e.id}/enter`, { method: 'POST', params: { support_trtc: true } }); }
    catch (ex) { err = ex.message; }
    const rv = (enter && enter.roomVo) || null;
    const diff = rv ? diffRooms(e.last, rv) : [];
    const inOther = TABS.filter((t) => (cache[t] || []).some((r) => rid(r) === e.id));
    push(e, 'probe' + (err ? ' FAILED' : rv ? '' : ' (no roomVo)'), { diff, raw: enter, err, inOther });
    console.log('[ti-ghost] probe', e.id, { lastListing: e.last, enter, diff, err, alsoListedIn: inOther });
    return { rv, err, enter, diff, inOther };
  }

  // Turn a probe result into a verdict. The distinction that matters is
  // "unlisted but still enterable with live RTC creds" (the case worth
  // chasing) vs "the host stopped" (noise). enter succeeding is NOT by itself
  // proof of life — the server happily returns a room record for a stream that
  // has ended, just with inLive false and no rtc credentials.
  function classify(res) {
    if (res.err) return { state: 'dead', why: 'enter failed — ' + res.err };
    const rtc = !!(res.enter && res.enter.rtcAppId);
    if (!res.rv) return { state: 'unclear', why: 'enter ok, no roomVo' + (rtc ? ' · rtc creds' : '') };
    if (res.rv.inLive === false) return { state: 'ended', why: 'roomVo inLive=false' };
    if (rtc) return { state: 'alive', why: 'enter ok · rtc creds' + (res.inOther.length ? ' · listed in ' + res.inOther.join(',') : ' · unlisted') };
    return { state: 'unclear', why: 'roomVo ok but no rtc creds' };
  }

  // Probes run one at a time with a gap — a burst of enter calls the instant a
  // scan finishes is both rude and a good way to get rate-limited.
  const probeQueue = [];
  let probing = false;

  function queueProbe(e) {
    if (e.probed) return;
    e.probed = true;
    e.verdict = { state: 'queued', why: 'waiting to probe' };
    probeQueue.push(e);
    runProbes();
  }

  async function runProbes() {
    if (probing) return;
    probing = true;
    while (probeQueue.length) {
      const e = probeQueue.shift();
      if (!registry.has(e.id)) continue;                    // aged out mid-queue
      if (!isGhost(e)) { e.verdict = null; e.probed = false; continue; }   // came back
      // Already playing in one of our windows — we know it's alive, and
      // re-entering would put our uid in the channel twice.
      if (openRooms.has(e.id)) {
        e.verdict = { state: 'alive', why: 'open in a player window' };
        push(e, 'auto-probe skipped: already playing');
        refreshGhosts();
        continue;
      }
      e.verdict = { state: 'probing', why: '' };
      refreshGhosts();
      const res = await probeGhost(e);
      e.verdict = classify(res);
      e.verdict.diff = res.diff;
      if (e.verdict.state === 'alive') {
        console.log('%c[ti-ghost] ALIVE BUT UNLISTED', 'color:#7f7;font-weight:bold', e.id,
          (e.last && (e.last.roomName || e.last.nickname)) || '',
          res.diff.length ? '· changed: ' + res.diff.join(' | ') : '· no field changed vs last listing');
        // Alive and unlisted is exactly the case worth chasing — go find out
        // which list it moved to, if any. Cheap mode: the two big lists were
        // enumerated seconds ago, so only the country filter gets walked.
        if (AUTO_LOCATE) { try { await locateRoom(e, null, true); } catch (err) {} }
      }
      refreshGhosts();
      await new Promise((r) => setTimeout(r, PROBE_GAP_MS));
    }
    probing = false;
  }

  function refreshGhosts() {
    if (!statusEl) return;
    if (activeTab === 'ghosts') renderList(); else updateTabStyles();
  }

  // ========================================================================
  // LIST DISCOVERY  —  "gone from all lists" only means "gone from the two
  // endpoints we know about". These probe for the ones we don't.
  // ========================================================================
  // Different list endpoints may wrap their payload under a different key.
  const ROOMS_KEYS = ['rooms', 'list', 'records', 'items', 'data', 'roomList', 'liveRooms'];
  function pickRooms(d) {
    if (!d) return { rooms: [], key: null };
    if (Array.isArray(d)) return { rooms: d, key: '(array)' };
    for (const k of ROOMS_KEYS) {
      if (Array.isArray(d[k]) && d[k].length && typeof d[k][0] === 'object') return { rooms: d[k], key: k };
    }
    for (const k of Object.keys(d)) {   // last resort: any array of objects
      if (Array.isArray(d[k]) && d[k].length && typeof d[k][0] === 'object' && (d[k][0].roomId || d[k][0].strRoomId)) return { rooms: d[k], key: k };
    }
    return { rooms: [], key: null };
  }
  const hasId = (r) => !!(r && (r.roomId != null || r.strRoomId));

  async function probeList(ep, params) {
    try {
      const d = await api(ep, { params });
      const { rooms, key } = pickRooms(d);
      return { ok: true, rooms: rooms.filter(hasId), key, hasMore: d && d.hasMore };
    } catch (e) { return { ok: false, err: e.message, rooms: [] }; }
  }

  // Every list we can search for a specific room.
  // cheap = skip re-walking the two lists we just enumerated (the auto path
  // runs right after a scan, so those caches are seconds old).
  function searchableLists(cc, cheap) {
    const out = cheap ? [] : [
      { label: 'regular', ep: '/video_living/rooms/v2', params: (p) => ({ page: p, size: PAGE_SZ, countryFilter: '' }), cap: 12 },
      { label: 'premium', ep: '/video_living/premium/rooms/', params: (p) => ({ page: p, size: PAGE_SZ }), cap: 12 },
    ];
    // A room dropped from the unfiltered list can still be present under its
    // own country filter — that alone would explain a "disappearance".
    if (cc) out.push({ label: 'regular?countryFilter=' + cc, ep: '/video_living/rooms/v2', params: (p) => ({ page: p, size: PAGE_SZ, countryFilter: cc }), cap: 10 });
    return out;
  }

  // Walk each searchable list looking for one room id. Answers "where does it
  // live now" rather than just "is it gone".
  async function locateRoom(e, onProgress, cheap) {
    const cc = (e.last && e.last.countryCode) || '';
    const lists = searchableLists(cc, cheap);
    const found = [], searched = [];
    for (const L of lists) {
      if (onProgress) onProgress(L.label);
      let hit = null;
      for (let p = 1; p <= L.cap && !hit; p++) {
        const res = await probeList(L.ep, L.params(p));
        if (!res.ok) break;
        const m = res.rooms.find((r) => rid(r) === e.id);
        if (m) hit = { page: p, room: m };
        if (!res.hasMore || !res.rooms.length) break;
      }
      searched.push(L.label);
      if (hit) found.push({ list: L.label, page: hit.page, diff: diffRooms(e.last, hit.room), room: hit.room });
    }
    push(e, found.length ? 'located in ' + found.map((f) => f.list).join(', ') : 'not found in ' + searched.length + ' lists',
      { diff: found.length ? found[0].diff : [] });
    console.log('[ti-locate]', e.id, found.length ? found : 'not found in: ' + searched.join(', '));
    if (found.length) {
      e.verdict = { state: 'moved', why: 'now in ' + found.map((f) => f.list).join(', '), diff: found[0].diff };
    }
    return { found, searched };
  }

  window.__tiRegistry = registry;
  window.__tiGhosts = ghosts;
  window.__tiLocate = locateRoom;

  // ---- gather everything needed to play one room --------------------------
  // A single enter call returns provider, Agora appId/token, viewer uid, the
  // channel (strRoomId) and, for Tencent rooms, the LEB webrtc pull URL.
  const baseFields = (r) => ({
    roomId: rid(r), streamerUid: r.uid,
    name: r.roomName || r.nickname || r.strRoomId || '',
    country: r.countryCode || '??', count: r.onlineCount || 0,
  });

  async function getPlayInfo(r) {
    let e = {}, err = null;
    try { e = await api(`/video_living/${rid(r)}/enter`, { method: 'POST', params: { support_trtc: true } }); }
    catch (ex) { err = ex.message; console.warn('[ti-rooms] enter failed', rid(r), ex.message); }
    const rv = e.roomVo || {};
    // Playing a ghost is itself a datapoint: record what enter said about it.
    const reg = registry.get(rid(r));
    if (reg && isGhost(reg) && Object.keys(rv).length) {
      push(reg, 'played while ghosted', { diff: diffRooms(reg.last, rv), raw: e });
    }
    const provide = e.rtcProvide != null ? e.rtcProvide : r.rtcProvide;
    const appId = e.rtcAppId || null;
    const token = e.rtcToken || null;
    return {
      ...baseFields(r),
      provide, appId, token,
      channel: rv.strRoomId || rid(r),
      viewerUid: (e.me && e.me.uid != null) ? e.me.uid : null,
      err,
      dbg: 'p' + provide + ' appId' + (appId ? 1 : 0) + ' tok' + (token ? 1 : 0) + (err ? ' ENTER-FAIL' : ' enterOK'),
    };
  }

  // rooms currently playing in some open window (to avoid joining a channel
  // with our uid twice). Tracked optimistically here; player windows send
  // 'ti-close' when a tile stops or the window unloads.
  const openRooms = new Set();
  window.__tiOpen = openRooms;      // __tiOpen.clear() resets every stuck flag

  // ---- open direct player window (1 or up to 6 tiles) ---------------------
  async function openPlayers(sel) {
    const chosen = sel.slice(0, GRID_N);
    const items = await Promise.all(chosen.map(async (r) => {
      // already playing elsewhere → placeholder tile, don't load again
      if (openRooms.has(rid(r))) return { ...baseFields(r), provide: r.rtcProvide, alreadyOpen: true };
      openRooms.add(rid(r));   // optimistic: we're about to load it
      try { return await getPlayInfo(r); }
      catch (e) { openRooms.delete(rid(r)); return { ...baseFields(r), provide: r.rtcProvide, err: e && e.message }; }
    }));
    renderList();   // reflect open/live state in the list
    const html = buildPlayerPage(items);
    const blobUrl = URL.createObjectURL(new Blob([html], { type: 'text/html' }));
    let feat;
    if (chosen.length > 1) {
      feat = 'width=1280,height=860';
    } else {
      // single pop-out: 9:16 portrait, as tall as the available screen height
      const h = (window.screen && window.screen.availHeight) || window.innerHeight || 840;
      const w = Math.round(h * 9 / 16);
      feat = `width=${w},height=${h},top=0,left=0`;
    }
    window.open(blobUrl, '_blank', feat);
  }

  // messages from player windows
  window.addEventListener('message', (e) => {
    const m = e.data || {};
    if (!m) return;
    if (m.type === 'ti-close' && m.roomId) { openRooms.delete(String(m.roomId)); renderList(); }
    if (m.type === 'ti-popout' && m.roomId) {
      const room = roomById.get(String(m.roomId));
      if (room) openPlayers([room]);
    }
  });

  // ---- runtime that runs INSIDE the blob player window --------------------
  // Written as a normal function and serialized via toString(); it may only
  // reference its `cfg` argument, browser globals, and window.AgoraRTC.
  function playerRuntime(cfg) {
    var AG = window.AgoraRTC;
    var TR = window.TRTC;
    // Silence autoplay/other blocking dialogs so tiles don't need a click.
    try { window.alert = function () {}; window.confirm = function () { return true; }; window.prompt = function () { return null; }; } catch (e) {}
    if (AG) { try { AG.onAutoplayFailed = function () {}; } catch (e) {} }
    // The RTC SDKs inject a "Resume" autoplay-recovery mask into the DOM. Auto-
    // click it (resumes the muted video) so the user never has to.
    (function maskResume() {
      function zap(root) {
        try {
          var nodes = root.querySelectorAll ? root.querySelectorAll('button,div,span,a,p') : [];
          for (var i = 0; i < nodes.length; i++) {
            var el = nodes[i], t = (el.textContent || '').trim();
            if (t && t.length <= 24 && /resume|click to (resume|play)|tap to|恢复|播放/i.test(t)) { try { el.click(); } catch (e) {} try { el.style.display = 'none'; } catch (e) {} }
          }
        } catch (e) {}
      }
      try {
        var mo = new MutationObserver(function (muts) {
          for (var i = 0; i < muts.length; i++) {
            var an = muts[i].addedNodes;
            for (var j = 0; j < an.length; j++) { if (an[j].nodeType === 1) zap(an[j]); }
          }
        });
        mo.observe(document.documentElement, { childList: true, subtree: true });
      } catch (e) {}
    })();
    function esc(s) { return (s || '').replace(/[<>&"]/g, ''); }
    function openPage(room) { window.open(cfg.page + room.roomId + '&uid=' + room.streamerUid, '_blank', 'width=460,height=840'); }
    function popout(room) { if (window.opener) window.opener.postMessage({ type: 'ti-popout', roomId: room.roomId }, '*'); }
    // Tell the opener which rooms this window is actually playing, so it won't
    // load the same channel in another window.
    var liveRooms = {};
    function announceClose(id) { if (window.opener) { try { window.opener.postMessage({ type: 'ti-close', roomId: id }, '*'); } catch (e) {} } delete liveRooms[id]; }
    // A tile dying on its own (host left, channel torn down) is the moment a
    // room actually stops streaming — tell the opener so it can separate
    // "hidden but alive" from "really ended".
    function announceEnd(id, why) { if (window.opener) { try { window.opener.postMessage({ type: 'ti-ended', roomId: id, why: why }, '*'); } catch (e) {} } }
    window.addEventListener('pagehide', function () { Object.keys(liveRooms).forEach(function (id) { if (window.opener) { try { window.opener.postMessage({ type: 'ti-close', roomId: id }, '*'); } catch (e) {} } }); });

    // Tencent TRTC (rtcProvide 2) — join as audience, subscribe to the host.
    async function playTRTC(media, room) {
      if (!TR) throw new Error('TRTC SDK unavailable');
      var trtc = TR.create();
      var audioUsers = [], muted = true;
      trtc.on(TR.EVENT.REMOTE_VIDEO_AVAILABLE, function (ev) {
        try { trtc.startRemoteVideo({ userId: ev.userId, streamType: ev.streamType, view: media }); } catch (e) { console.error('startRemoteVideo', e); }
      });
      trtc.on(TR.EVENT.REMOTE_AUDIO_AVAILABLE, function (ev) {
        audioUsers.push(ev.userId); try { trtc.muteRemoteAudio(ev.userId, muted); } catch (e) {}
      });
      try { if (TR.EVENT.REMOTE_USER_EXIT) trtc.on(TR.EVENT.REMOTE_USER_EXIT, function () { announceEnd(room.roomId, 'host left (trtc)'); }); } catch (e) {}
      // Ignore autoplay-blocked (tiles start muted) so no click-to-dismiss prompt.
      try { if (TR.EVENT.AUTOPLAY_FAILED) trtc.on(TR.EVENT.AUTOPLAY_FAILED, function () {}); } catch (e) {}
      await trtc.enterRoom({
        sdkAppId: Number(room.appId), userId: String(room.viewerUid),
        userSig: room.token, strRoomId: room.channel, scene: 'live', role: 'audience',
      });
      return {
        setMuted: function (m) { muted = m; audioUsers.forEach(function (u) { try { trtc.muteRemoteAudio(u, m); } catch (e) {} }); },
        stop: function () { try { return trtc.exitRoom(); } catch (e) {} },
      };
    }

    // Agora (rtcProvide 1)
    async function playAgora(media, room) {
      if (!AG) throw new Error('Agora SDK unavailable');
      var client = AG.createClient({ mode: 'live', codec: 'vp8' });
      if (client.setClientRole) { try { await client.setClientRole('audience'); } catch (e) {} }
      var audios = [], muted = true;
      client.on('user-published', async function (user, kind) {
        try {
          await client.subscribe(user, kind);
          if (kind === 'video' && user.videoTrack) user.videoTrack.play(media);
          // Don't play audio while muted — playing it triggers the autoplay
          // "Media Playback error" prompt. Defer until the user unmutes.
          if (kind === 'audio' && user.audioTrack) { audios.push(user.audioTrack); if (!muted) { try { user.audioTrack.setVolume(100); user.audioTrack.play(); } catch (e) {} } }
        } catch (e) { console.error('subscribe', e); }
      });
      client.on('user-left', function () { announceEnd(room.roomId, 'host left (agora)'); });
      await client.join(room.appId, room.channel, room.token || null, room.viewerUid == null ? null : room.viewerUid);
      return {
        setMuted: function (m) { muted = m; audios.forEach(function (a) { try { a.setVolume(m ? 0 : 100); if (!m) a.play(); } catch (e) {} }); },
        stop: function () { try { return client.leave(); } catch (e) {} },
      };
    }

    // Image controls (single pop-out window): brightness/contrast/saturation/
    // alpha sliders behind a gear button, applied as CSS filters on the media.
    function addImageControls(cell, bar, media) {
      var st = { bright: 100, contrast: 100, sat: 100, alpha: 100 };
      function apply() {
        media.style.filter = 'brightness(' + st.bright + '%) contrast(' + st.contrast + '%) saturate(' + st.sat + '%)';
        media.style.opacity = String(st.alpha / 100);
      }
      var btn = document.createElement('button'); btn.className = 'mb'; btn.innerHTML = '&#9881;'; btn.title = 'image controls';
      bar.appendChild(btn);
      var panel = document.createElement('div');
      panel.style.cssText = 'position:absolute;top:36px;right:6px;z-index:6;background:rgba(18,18,18,.94);border:1px solid #444;border-radius:8px;padding:10px 12px;width:214px;display:none;font:12px system-ui,sans-serif;color:#eee';
      var rows = [];
      [['Brightness', 'bright', 0, 300], ['Contrast', 'contrast', 0, 300], ['Saturation', 'sat', 0, 300], ['Alpha', 'alpha', 10, 100]].forEach(function (d) {
        var wrap = document.createElement('div'); wrap.style.cssText = 'margin-bottom:9px';
        var lab = document.createElement('div'); lab.style.cssText = 'display:flex;justify-content:space-between;margin-bottom:3px';
        var nm = document.createElement('span'); nm.textContent = d[0];
        var val = document.createElement('span'); val.style.color = '#8cf'; val.textContent = st[d[1]] + '%';
        lab.appendChild(nm); lab.appendChild(val);
        var sl = document.createElement('input'); sl.type = 'range'; sl.min = d[2]; sl.max = d[3]; sl.value = st[d[1]]; sl.step = 1; sl.style.width = '100%';
        sl.oninput = function (e) { e.stopPropagation(); st[d[1]] = +sl.value; val.textContent = sl.value + '%'; apply(); };
        sl.onclick = function (e) { e.stopPropagation(); };
        wrap.appendChild(lab); wrap.appendChild(sl); panel.appendChild(wrap);
        rows.push({ key: d[1], sl: sl, val: val });
      });
      var reset = document.createElement('button'); reset.textContent = 'reset';
      reset.style.cssText = 'width:100%;background:#2b2b2b;color:#eee;border:1px solid #444;border-radius:6px;padding:4px 0;cursor:pointer;font:12px system-ui';
      reset.onclick = function (e) { e.stopPropagation(); rows.forEach(function (r) { st[r.key] = 100; r.sl.value = 100; r.val.textContent = '100%'; }); apply(); };
      panel.appendChild(reset);
      cell.appendChild(panel);
      btn.onclick = function (e) { e.stopPropagation(); panel.style.display = panel.style.display === 'none' ? 'block' : 'none'; };
    }

    var grid = document.getElementById('grid');
    cfg.rooms.forEach(function (room) {
      var cell = document.createElement('div'); cell.className = 'cell';
      var media = document.createElement('div'); media.className = 'media';
      var bar = document.createElement('div'); bar.className = 'bar';
      bar.innerHTML = '<span class=flag>' + esc(room.country) + '</span><span class=nm>' + esc(room.name) + '</span><span class=cnt>&#128100; ' + room.count + '</span>';
      var inGrid = cfg.rooms.length > 1;
      var mute = document.createElement('button'); mute.className = 'mb'; mute.innerHTML = '&#128263;'; mute.style.opacity = '0.5';
      bar.appendChild(mute);
      if (inGrid) { var pop = document.createElement('button'); pop.className = 'mb'; pop.innerHTML = '&#8689;'; pop.title = 'open in its own window'; bar.appendChild(pop); }
      else addImageControls(cell, bar, media);
      var hit = document.createElement('div'); hit.className = 'hit';
      var st = document.createElement('div'); st.className = 'st'; st.textContent = 'connecting…';
      cell.appendChild(media); cell.appendChild(bar); cell.appendChild(hit); cell.appendChild(st);
      grid.appendChild(cell);

      var player = null, isMuted = true, popping = false;
      function setMute(m) { isMuted = m; mute.style.opacity = m ? '0.5' : '1'; if (player && player.setMuted) player.setMuted(m); }
      // Leave the channel HERE before the standalone window joins it, so the
      // same viewer uid isn't in the same room twice.
      async function popoutTile() {
        if (popping) return;
        popping = true;
        st.style.display = 'flex'; st.innerHTML = '&#8599; opening in its own window…';
        if (player && player.stop) { try { await player.stop(); } catch (e) {} }
        player = null;
        announceClose(room.roomId);   // free it in the opener before the single window joins
        try { while (media.firstChild) media.removeChild(media.firstChild); } catch (e) {}
        await new Promise(function (r) { setTimeout(r, 250); });   // let the RTC server release the uid
        popout(room);
        st.innerHTML = '&#8599; opened in its own window<br><u>click to reopen</u>';
        st.onclick = function () { popout(room); };
        popping = false;
      }
      mute.onclick = function (ev) { ev.stopPropagation(); if (room.alreadyOpen) return; setMute(!isMuted); };
      if (inGrid) pop.onclick = function (ev) { ev.stopPropagation(); if (room.alreadyOpen) return; popoutTile(); };
      hit.onclick = function () { if (room.alreadyOpen) return; if (inGrid) popoutTile(); else setMute(!isMuted); };
      function fail(msg) { st.style.display = 'flex'; st.innerHTML = '&#9888; ' + esc(msg) + '<br><small style="color:#888">' + esc(room.dbg || '') + (room.err ? ' · ' + esc(room.err) : '') + '</small><br><u>open room page</u>'; st.onclick = function () { openPage(room); }; }

      console.log('[ti-tile]', room.roomId, room.dbg, room.err || '', room);
      if (room.alreadyOpen) { st.style.display = 'flex'; st.innerHTML = '&#128274; already open<br>in another window'; return; }
      var pr = null;
      if (room.provide === 1 && room.appId) pr = playAgora(media, room);
      else if (room.provide === 2 && room.appId) pr = playTRTC(media, room);
      else fail('no direct stream');
      if (pr) pr.then(function (p) { player = p; if (p.setMuted) p.setMuted(true); st.style.display = 'none'; liveRooms[room.roomId] = true; })
              .catch(function (e) { fail((e && e.message) || 'failed'); announceClose(room.roomId); });
    });
  }

  // ---- build the blob player page (loads Agora SDK, then the runtime) -----
